#!/bin/sh
# Refuse commits that stage game content, keys or generated game code.
# Enable with: git config core.hooksPath .githooks
# The same check runs in CI (.github/workflows/content-guard.yml).

if command -v python3 >/dev/null 2>&1 && python3 -c "" >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "pre-commit: Python not found; cannot run tools/check_content.py" >&2
    exit 1
fi

exec "$PYTHON" tools/check_content.py --staged
